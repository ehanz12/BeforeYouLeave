#app env
APP_ENV=development 

#configurasi database

DB_USER = user_password
DB_PASSWORD = database_password
DB_HOST = 127.0.0.1
DB_NAME = database_name
DB_PORT = database_port
PORT = ":3000"



# Standard Baseline Aplikasi Harian (Low-Medium Traffic)
DB_MAX_OPEN_CONNS = 25
DB_MAX_IDLE_CONNS = 25
DB_CONN_MAX_LIFETIME_MIN = 15
DB_CONN_MAX_IDLE_TIME_MIN = 5


#jwt
JWT_SECRET = YOU_CHANGE_JWT