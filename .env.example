#app env
APP_ENV=development 

#configurasi database

DB_USER = user_password
DB_PASSWORD = database_password
DB_HOST = 127.0.0.1
DB_NAME = database_name
DB_PORT = database_port
PORT = 8080



# Standard Baseline Aplikasi Harian (Low-Medium Traffic)
DB_MAX_OPEN_CONNS = 25
DB_MAX_IDLE_CONNS = 25
DB_CONN_MAX_LIFETIME_MIN = 15
DB_CONN_MAX_IDLE_TIME_MIN = 5


#jwt
#wajib di-set, server menolak start kalau kosong
#generate: openssl rand -hex 32
JWT_SECRET=YOU_CHANGE_JWT

#google auth (opsional, wajib kalau memakai POST /api/auth/google)
GOOGLE_CLIENT_ID=

#timezone aplikasi (harus sama dengan loc= di DSN)
APP_TIMEZONE = Asia/Jakarta

#worker reminder
#berapa hari ke depan reminder di-generate
REMINDER_HORIZON_DAYS = 14
#seberapa sering worker membuat reminder baru (menit)
REMINDER_GENERATE_INTERVAL_MIN = 60
#seberapa sering pending -> sent (menit)
REMINDER_DISPATCH_INTERVAL_MIN = 5
